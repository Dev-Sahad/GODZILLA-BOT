# ═══════════════════════════════════════════════════════════════════════════════
#  🦖 GODZILLA BOT — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core Bot Settings ────────────────────────────────────────────────────────
BOT_NAME=GODZILLA
BOT_PREFIX=.
# Owner WhatsApp number with country code (no '+' or special characters)
OWNER_NUMBER=918147120709
# Bot Mode: public (everyone), private (owner only), or group (groups only)
BOT_MODE=public
# Command cooldown in seconds per user
COOLDOWN_SECONDS=5

# ── AI Integration (Google Gemini AI) ─────────────────────────────────────────
# Required for .ai, image understanding, vision, and smart replies
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative alias: GOOGLE_API_KEY=your_gemini_api_key_here

# ── Web Admin Panel (HTML & CSS Dashboard) ───────────────────────────────────
# Password used to log in and control the bot from your browser
ADMIN_PASSWORD=godzilla2025

# ── Cloud Deployment & Persistence ───────────────────────────────────────────
# Run 'npm run session' locally after scanning QR code to generate this string.
# Paste the base64 session string here for 24/7 cloud hosts (Railway, Render, VPS).
GODZILLA_SESSION=

# ── Server / Port (Automatically set by Railway and Render) ──────────────────
# PORT=3000

